# ==========================================
# NYC Taxi Pipeline - Environment Configuration
# ==========================================
# Copy this file to .env and replace placeholders with actual credentials

# --- Airflow Configuration ---
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
FERNET_KEY=your_generated_fernet_key_here
AIRFLOW__API_AUTH__JWT_SECRET=your_jwt_secret_here

# --- Azure Data Lake Storage Gen2 (ADLS Gen2) ---
AZURE_STORAGE_ACCOUNT=your_storage_account_name
AZURE_STORAGE_KEY=your_storage_account_primary_key
ADLS_CONTAINER=external

# --- Databricks & Unity Catalog ---
DATABRICKS_HOST=https://<your-workspace>.azuredatabricks.net
DATABRICKS_TOKEN=dapi_your_personal_access_token_here
DATABRICKS_WAREHOUSE_ID=your_sql_warehouse_http_path_or_id
DATABRICKS_BRONZE_JOB_ID=your_databricks_job_id_for_autoloader

# --- dbt Configuration ---
DBT_PROFILES_DIR=/dbt_nyc_taxi
DBT_PROJECT_PATH=/dbt_nyc_taxi
